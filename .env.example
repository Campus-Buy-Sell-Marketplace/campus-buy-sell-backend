# ──────────────────────────────────────────────
# Campus Marketplace — Backend Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/campus_marketplace

# JWT — use a long random string (min 32 characters)
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Google OAuth credentials
# Get from: https://console.cloud.google.com/
# Authorized redirect URI must be: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URL (for CORS and redirects after Google OAuth)
CLIENT_URL=http://localhost:5173
