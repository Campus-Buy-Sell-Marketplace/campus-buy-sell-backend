{
  "name": "campus-buy-sell-backend",
  "version": "1.0.0",
  "description": "Backend API for Campus Marketplace — shared by web and mobile apps",
  "scripts": {
    "dev": "nodemon",
    "db:init": "node -r dotenv/config -r ts-node/register src/db/migrate.ts",
    "seed": "node -r dotenv/config -r ts-node/register src/db/seed.ts",
    "build": "tsc",
    "start": "node -r dotenv/config dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.16.5",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.9",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
